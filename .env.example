# Скопіюйте у .env і заповніть:  cp .env.example .env

# ---------- Telegram ----------
# Токен від @BotFather
BOT_TOKEN=
# Telegram адміністратора(ів): @username або числовий id, через кому
ADMIN_TELEGRAM=@admin_username

# ---------- База даних ----------
POSTGRES_USER=barber
POSTGRES_PASSWORD=
POSTGRES_DB=barber
# Лише для запуску без Docker (локальна розробка):
# DATABASE_URL=postgresql+asyncpg://barber:ПАРОЛЬ@localhost:5432/barber

# ---------- Адмін-панель ----------
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Випадковий рядок для підпису сесій: openssl rand -hex 32
ADMIN_SECRET_KEY=
ADMIN_PORT=8000

# HTTPS через Caddy (домен має вказувати на IP сервера):
# COMPOSE_PROFILES=https
# ADMIN_DOMAIN=admin.example.com
# ADMIN_HTTPS_ONLY=true

# ---------- Заклад ----------
SHOP_NAME=Барбершоп «Назва»
SHOP_ADDRESS=Ізюм, Поворотка
SHOP_HOURS=Щодня 09:00–19:00
SHOP_PHONE=+380 00 000 00 00
# Instagram без @ (порожньо — у контактах не показується)
SHOP_INSTAGRAM=
# Координати точки на карті (Google Maps → правий клік на точці → скопіювати координати)
SHOP_LAT=49.1245
SHOP_LON=37.1511

# ---------- Правила ----------
TIMEZONE=Europe/Kyiv
BOOKING_DAYS_AHEAD=14
SLOT_STEP_MIN=30
MIN_LEAD_MIN=30
CANCEL_DEADLINE_HOURS=3
